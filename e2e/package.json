{
  "name": "@aiontheballot/e2e",
  "version": "0.18.31",
  "private": true,
  "description": "Playwright end-to-end tests, run against production builds of the apps",
  "type": "module",
  "scripts": {
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@aiontheballot/i18n": "workspace:*",
    "@aiontheballot/mcp": "workspace:*",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@slango.configs/lint-staged": "2.0.8",
    "@slango.configs/oxlint": "0.1.13",
    "@slango.configs/typescript": "3.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.10",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "8.23.1",
    "typescript": "7.0.2"
  }
}

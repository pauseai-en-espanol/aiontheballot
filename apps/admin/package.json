{
  "name": "@aiontheballot/admin",
  "version": "0.31.0",
  "private": true,
  "description": "Admin: editorial workflow on the central admin host",
  "type": "module",
  "scripts": {
    "dev": "concurrently 'next dev -p 3002' 'panda --watch'",
    "build": "panda codegen && next build",
    "build:check": "next typegen && tsc --noEmit",
    "start": "next start -p 3002",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || panda codegen",
    "docker:build": "docker buildx build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} -t \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}aiontheballot/admin:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\" -f Dockerfile ../..",
    "docker:push": "docker push \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}aiontheballot/admin:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\""
  },
  "dependencies": {
    "@aiontheballot/domain": "workspace:*",
    "@aiontheballot/i18n": "workspace:*",
    "@aiontheballot/observability": "workspace:*",
    "@aiontheballot/og": "workspace:*",
    "@ark-ui/react": "5.39.3",
    "@sentry/nextjs": "11.8.0",
    "iso-3166": "4.4.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@aiontheballot/ui": "workspace:*",
    "@pandacss/dev": "2.2.0",
    "@pandacss/preset-base": "2.2.0",
    "@pandacss/preset-panda": "2.2.0",
    "@slango.configs/lint-staged": "2.0.9",
    "@slango.configs/oxlint": "0.1.14",
    "@slango.configs/typescript": "3.0.1",
    "@slango.configs/vitest": "2.1.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "concurrently": "10.0.6",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "8.5.30",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

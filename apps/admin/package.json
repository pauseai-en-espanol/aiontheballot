{
  "name": "@ballot/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Admin: editorial workflow on the central admin host",
  "type": "module",
  "scripts": {
    "dev": "concurrently 'next dev -p 3002' 'panda --watch'",
    "build": "next build",
    "build:check": "next typegen && tsc --noEmit",
    "start": "next start -p 3002",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || panda codegen"
  },
  "dependencies": {
    "@ballot/i18n": "workspace:*",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@ballot/ui": "workspace:*",
    "@pandacss/dev": "2.1.1",
    "@pandacss/preset-base": "2.1.1",
    "@pandacss/preset-panda": "2.1.1",
    "@slango.configs/lint-staged": "2.0.8",
    "@slango.configs/oxlint": "0.1.12",
    "@slango.configs/typescript": "2.1.0",
    "@slango.configs/vitest": "2.0.67",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "concurrently": "10.0.5",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "8.5.29",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

{
  "name": "@aiontheballot/db",
  "version": "0.18.2",
  "private": true,
  "description": "Database access for the API and worker: Kysely, generated types and withActor",
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run --pass-with-no-tests",
    "test:db": "vitest --run --config vitest.db.config.ts"
  },
  "dependencies": {
    "kysely": "0.29.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@aiontheballot/domain": "workspace:*",
    "@slango.configs/lint-staged": "2.0.11",
    "@slango.configs/oxlint": "0.1.16",
    "@slango.configs/typescript": "3.0.1",
    "@slango.configs/vitest": "2.1.5",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "dbmate": "2.37.0",
    "kysely-codegen": "0.20.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

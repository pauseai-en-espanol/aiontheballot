# Copy to .env for local development. dbmate reads DATABASE_URL from .env.
# These are the local, non-secret defaults from compose.yaml.
DATABASE_URL=postgres://aiontheballot_owner:dev-only-owner@localhost:5432/aiontheballot?sslmode=disable
TEST_DATABASE_URL=postgres://aiontheballot_owner:dev-only-owner@localhost:5432/aiontheballot_test?sslmode=disable
TEST_SUPERUSER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiontheballot_test?sslmode=disable
# Better Auth's own role (ADR-0002 §2), for the API's database tests.
TEST_AUTH_DATABASE_URL=postgres://aiontheballot_auth:dev-only-auth@localhost:5432/aiontheballot_test?sslmode=disable
# The admin role, which signed-in requests run as (withActor), for the API's database tests.
TEST_ADMIN_DATABASE_URL=postgres://aiontheballot_admin:dev-only-admin@localhost:5432/aiontheballot_test?sslmode=disable
# The API's public routes read as aiontheballot_web (the end-to-end tests need it, with `pnpm db:seed`).
WEB_DATABASE_URL=postgres://aiontheballot_web:dev-only-web@localhost:5432/aiontheballot?sslmode=disable
# The admin's preview of a site reads as aiontheballot_preview, which also sees elections in preview (PLAN R181); the
# API serves it only with PREVIEW_TOKEN (32 characters or more), and needs both or neither. The end-to-end tests set
# their own token for the servers they start.
PREVIEW_DATABASE_URL=postgres://aiontheballot_preview:dev-only-preview@localhost:5432/aiontheballot?sslmode=disable
PREVIEW_TOKEN=dev-only-preview-token-of-more-than-32-characters
# Sign-in runs as Better Auth's role, and signed-in requests as the admin role (ADR-0002 §2); the end-to-end tests need
# both. Running the API by hand with sign-in also needs ADMIN_ORIGIN, BETTER_AUTH_SECRET and PLATFORM_NAME.
AUTH_DATABASE_URL=postgres://aiontheballot_auth:dev-only-auth@localhost:5432/aiontheballot?sslmode=disable
ADMIN_DATABASE_URL=postgres://aiontheballot_admin:dev-only-admin@localhost:5432/aiontheballot?sslmode=disable
# The worker (PLAN R116), which extracts sources' text as aiontheballot_worker; the end-to-end tests run it, with a
# WORKER_TOKEN of their own (ADR-0006). Run by hand, the worker and the API (with WORKER_URL) both need one, 32
# characters or more.
WORKER_DATABASE_URL=postgres://aiontheballot_worker:dev-only-worker@localhost:5432/aiontheballot?sslmode=disable
# Where stored files' bytes go (ADR-0004): `pnpm db:seed` writes the seeds' bytes there, and the end-to-end tests' API
# reads them. Unset, the seeds and the tests use .data/files in the repository. The API itself needs it set (with
# `pnpm dev`, to the repository's .data/files), or its brand-image route answers 503. Use an absolute path: the API, the
# seeds and the tests run from different folders.
# FILES_ROOT=/absolute/path/to/files

# scripts/watch-release.sh: the addresses that must answer 200 once a release is out, space-separated.
# WATCH_URLS="https://site.example https://admin.site.example/sign-in"

# The deployment's settings, for the operator's scripts (scripts/lib/settings.sh) and runbooks (docs/runbooks).
# They describe the operator's infrastructure, so they live only here in .env, never in the repository (PLAN R205);
# none is a secret. Load them into a shell for a runbook with `set -a; . ./.env; set +a`. One KEY=value per line,
# without `export` or a comment after the value; quote values with spaces, and single-quote values with a `$`.
# KUBE_CONTEXT=
# ARGO_NAMESPACE=
# ARGO_APP=aiontheballot
# APP_NAMESPACE=aiontheballot
# DATABASE_NAMESPACE=
# DATABASE_POD=
# GATEWAY_NAMESPACE=
# The seal scripts (scripts/seal-*.sh): kubeseal's arguments for the cluster ("--context … --controller-namespace …
# --controller-name …"), where in the gitops checkout the secrets go, and the in-cluster addresses they point to.
# KUBESEAL_ARGS=
# GITOPS_SECRETS_DIR=
# GITOPS_DATABASE_DIR=
# DATABASE_SERVICE=host:5432
# ERROR_TRACKER_SERVICE=host (the error tracker's in-cluster host, without scheme or path)
# REGISTRY_HOST=
# REGISTRY_ROBOT=
# REGISTRY_PULL_SECRET=
# The image scripts/seal-registry-pull-secret.sh asks to pull, to check the secret (aiontheballot/migrations if unset).
# REGISTRY_PROBE_REPOSITORY=
# scripts/check-private-terms.sh (in the pre-push hook and pnpm verify): the terms that must never appear in this
# repository, comma-separated. CI checks them only if a repository secret of the same name is set (PLAN R209).
# PRIVATE_TERMS=

{
  "name": "@aiontheballot/web",
  "version": "0.8.0",
  "private": true,
  "description": "Public site: scorecards, methodology and share images (no sessions, no cookies)",
  "type": "module",
  "scripts": {
    "dev": "concurrently 'next dev -p 3000' 'panda --watch'",
    "build": "panda codegen && next build",
    "build:check": "next typegen && tsc --noEmit",
    "start": "next start -p 3000",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || panda codegen",
    "docker:build": "docker buildx build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} -t \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}aiontheballot/web:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\" -f Dockerfile ../..",
    "docker:push": "docker push \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}aiontheballot/web:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\""
  },
  "dependencies": {
    "@aiontheballot/domain": "workspace:*",
    "@aiontheballot/i18n": "workspace:*",
    "@aiontheballot/observability": "workspace:*",
    "@aiontheballot/og": "workspace:*",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/roboto-slab": "5.3.0",
    "@fontsource/saira-condensed": "5.3.0",
    "@sentry/browser": "11.4.0",
    "@sentry/nextjs": "11.4.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@aiontheballot/ui": "workspace:*",
    "@pandacss/dev": "2.1.1",
    "@pandacss/preset-base": "2.1.1",
    "@pandacss/preset-panda": "2.1.1",
    "@slango.configs/lint-staged": "2.0.8",
    "@slango.configs/oxlint": "0.1.12",
    "@slango.configs/typescript": "3.0.0",
    "@slango.configs/vitest": "2.1.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "concurrently": "10.0.5",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "postcss": "8.5.29",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

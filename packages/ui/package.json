{
  "name": "@aiontheballot/ui",
  "version": "0.4.6",
  "private": true,
  "description": "Shared Panda preset and UI components (Ark UI) for the web and admin apps",
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aiontheballot/domain": "workspace:*",
    "@pandacss/dev": "2.4.0"
  },
  "devDependencies": {
    "@slango.configs/lint-staged": "2.0.9",
    "@slango.configs/oxlint": "0.1.14",
    "@slango.configs/typescript": "3.0.1",
    "@slango.configs/vitest": "2.1.3",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

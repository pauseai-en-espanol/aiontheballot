# Copy to .env for local development. dbmate reads DATABASE_URL from .env.
# These are the local, non-secret defaults from compose.yaml.
DATABASE_URL=postgres://aiontheballot_owner:dev-only-owner@localhost:5432/aiontheballot?sslmode=disable
TEST_DATABASE_URL=postgres://aiontheballot_owner:dev-only-owner@localhost:5432/aiontheballot_test?sslmode=disable
TEST_SUPERUSER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiontheballot_test?sslmode=disable
# The API's public routes read as aiontheballot_web (the end-to-end tests need it, with `pnpm db:seed`).
WEB_DATABASE_URL=postgres://aiontheballot_web:dev-only-web@localhost:5432/aiontheballot?sslmode=disable

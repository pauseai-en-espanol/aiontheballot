{
  "name": "@aiontheballot/mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "aiontheballot-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@slango.configs/lint-staged": "2.0.11",
    "@slango.configs/oxlint": "0.1.16",
    "@slango.configs/typescript": "3.0.1",
    "@slango.configs/vitest": "2.1.5",
    "@types/node": "26.6.5",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

{
  "name": "@aiontheballot/api",
  "version": "0.33.0",
  "private": true,
  "description": "Fastify API and worker: the only code that talks to Postgres",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "dev": "node --watch dist/server.js",
    "start": "node dist/server.js",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:db": "vitest --run --config vitest.db.config.ts",
    "test:coverage": "vitest --run --coverage",
    "docker:build": "docker buildx build ${DOCKER_PLATFORM:+--platform=$DOCKER_PLATFORM} -t \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}aiontheballot/api:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\" -f Dockerfile ../..",
    "docker:push": "docker push \"${DOCKER_REGISTRY:+${DOCKER_REGISTRY}/}aiontheballot/api:${npm_package_version}${DOCKER_TAG_SUFFIX:+.${DOCKER_TAG_SUFFIX}}\""
  },
  "dependencies": {
    "@aiontheballot/db": "workspace:*",
    "@aiontheballot/domain": "workspace:*",
    "@aiontheballot/i18n": "workspace:*",
    "@aiontheballot/observability": "workspace:*",
    "@mozilla/readability": "0.6.0",
    "@sentry/node": "11.8.0",
    "better-auth": "1.7.10",
    "fastify": "5.12.7",
    "html-encoding-sniffer": "7.0.0",
    "jsdom": "30.1.3",
    "kysely": "0.29.6",
    "nodemailer": "10.1.2",
    "pdfjs-dist": "6.4.299",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sentry/core": "11.8.0",
    "@slango.configs/lint-staged": "2.0.9",
    "@slango.configs/oxlint": "0.1.14",
    "@slango.configs/typescript": "3.0.1",
    "@slango.configs/vitest": "2.1.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

{
  "name": "@aiontheballot/domain",
  "version": "0.16.2",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@slango.configs/lint-staged": "2.0.11",
    "@slango.configs/oxlint": "0.1.16",
    "@slango.configs/typescript": "3.0.1",
    "@slango.configs/vitest": "2.1.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

{
  // slango's shared preset for an application: one weekly window early on Monday (ADR-0001), every non-major update
  // in one PR, a 3-day supply-chain delay (keep in sync with minimumReleaseAge in pnpm-workspace.yaml), @slango/* as
  // soon as it's released. Only this repository's own rules go here.
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>danilupion/slango//renovate/app.json5'],
  packageRules: [
    {
      // The share images' renderer (PLAN R147): an update may change every picture, so it gets a PR of its own,
      // whatever the update's type, where the reference test shows old, new and diff and `pnpm cards:accept` takes the
      // change. Listed after the preset's groups, so it takes these two out of them.
      matchPackageNames: ['satori', '@resvg/resvg-js'],
      groupName: 'Share-image renderer',
      groupSlug: 'share-image-renderer',
      automerge: false,
      labels: ['dependencies', 'share-images'],
    },
    {
      // The fflate override in pnpm-workspace.yaml keeps satori's font parser on the patched 0.7 line. 0.8 can't
      // inflate the cards' WOFF fonts (every glyph comes out as a box), so the override's value never leaves 0.7.
      matchPackageNames: ['fflate'],
      allowedVersions: '<0.8',
    },
  ],
}

{
  "name": "@aiontheballot/og",
  "version": "0.3.0",
  "private": true,
  "description": "Share-image templates and their renderer (satori, then resvg): ADR-0003 \u00a78",
  "type": "module",
  "exports": {
    "./*": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch -p tsconfig.build.json",
    "build:check": "tsc --noEmit",
    "lint": "oxlint --type-aware --max-warnings 0 .",
    "lint:fix": "oxlint --type-aware --fix --max-warnings 0 .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "prepare": "[ \"$PACKAGED\" = true ] && echo 'Skipping prepare for packaged production dependencies install' || tsc -p tsconfig.build.json",
    "fonts": "node scripts/embed-fonts.mjs"
  },
  "devDependencies": {
    "@slango.configs/lint-staged": "2.0.8",
    "@slango.configs/oxlint": "0.1.12",
    "@slango.configs/typescript": "3.0.0",
    "@slango.configs/vitest": "2.1.0",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@aiontheballot/ui": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "satori": "0.35.1"
  }
}
